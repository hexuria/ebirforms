{
  "name": "ebirforms",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/desktop dev",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "release": "bun run --cwd apps/desktop release"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "latest",
    "typescript": "latest"
  }
}
